{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/raw-transcripts/(.*)", "destination": "/api/index.js" },
    { "source": "/login", "destination": "/src/public/login" },
    { "source": "/access-denied", "destination": "/src/public/access-denied" },
    { "source": "/dashboard", "destination": "/src/public/index" },
    { "source": "/", "destination": "/src/public/index" },
    { "source": "/(.*)", "destination": "/src/public/$1" }
  ]
}
