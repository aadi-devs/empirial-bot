{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "daemons": {
    "empirial-bot": {
      "root": "./",
      "entrypoint": "Dockerfile",
      "instances": {
        "iad1": 1
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/raw-transcripts/(.*)", "destination": "/api/index.js" },
    { "source": "/login", "destination": "/src/public/login.html" },
    { "source": "/access-denied", "destination": "/src/public/access-denied.html" },
    { "source": "/dashboard", "destination": "/src/public/index.html" },
    { "source": "/", "destination": "/src/public/index.html" },
    { "source": "/(.*)", "destination": "/src/public/$1" }
  ]
}
